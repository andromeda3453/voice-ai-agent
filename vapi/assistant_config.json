{
  "name": "CareAssist - Patient Registration",
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-2",
    "language": "en"
  },
  "model": {
    "provider": "google",
    "model": "gemini-1.5-flash",
    "messages": [
      {
        "role": "system",
        "content": "You are CareAssist, a friendly medical intake receptionist. Collect patient demographic information step-by-step, verify before submitting, and call register_patient or update_patient to persist the data."
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "check_patient_by_phone",
          "description": "Checks if a patient record already exists in the system by their phone number.",
          "parameters": {
            "type": "object",
            "properties": {
              "phone_number": {
                "type": "string",
                "description": "The caller's contact phone number."
              }
            },
            "required": ["phone_number"]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "register_patient",
          "description": "Creates a new patient registration record once caller has confirmed all demographic details.",
          "parameters": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "description": "Patient's first name."
              },
              "last_name": {
                "type": "string",
                "description": "Patient's last name."
              },
              "date_of_birth": {
                "type": "string",
                "description": "Patient's date of birth in YYYY-MM-DD format."
              },
              "sex": {
                "type": "string",
                "enum": ["Male", "Female", "Other", "Unknown"],
                "description": "Biological sex / gender."
              },
              "phone_number": {
                "type": "string",
                "description": "Contact phone number."
              },
              "email": {
                "type": "string",
                "description": "Email address (optional)."
              },
              "address_line_1": {
                "type": "string",
                "description": "Primary street address."
              },
              "address_line_2": {
                "type": "string",
                "description": "Apartment, suite, or unit number (optional)."
              },
              "city": {
                "type": "string",
                "description": "City name."
              },
              "state": {
                "type": "string",
                "description": "US State (e.g. CA, NY)."
              },
              "zip_code": {
                "type": "string",
                "description": "Postal ZIP code."
              },
              "insurance_provider": {
                "type": "string",
                "description": "Health insurance provider name (optional)."
              },
              "insurance_member_id": {
                "type": "string",
                "description": "Insurance member ID or policy number (optional)."
              },
              "preferred_language": {
                "type": "string",
                "description": "Preferred spoken language, defaults to English."
              },
              "emergency_contact_name": {
                "type": "string",
                "description": "Emergency contact full name (optional)."
              },
              "emergency_contact_phone": {
                "type": "string",
                "description": "Emergency contact phone number (optional)."
              }
            },
            "required": [
              "first_name",
              "last_name",
              "date_of_birth",
              "sex",
              "phone_number",
              "address_line_1",
              "city",
              "state",
              "zip_code"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "update_patient",
          "description": "Updates an existing patient's details when requested by the caller.",
          "parameters": {
            "type": "object",
            "properties": {
              "patient_id": {
                "type": "string",
                "description": "UUID of the existing patient record."
              },
              "phone_number": {
                "type": "string",
                "description": "Patient phone number for lookup if ID unknown."
              },
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "date_of_birth": {
                "type": "string"
              },
              "address_line_1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "zip_code": {
                "type": "string"
              },
              "insurance_provider": {
                "type": "string"
              },
              "insurance_member_id": {
                "type": "string"
              }
            }
          }
        }
      }
    ]
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "21m00Tcm4TlvDq8ikWAM"
  },
  "firstMessage": "Thank you for calling Community Health Clinic. My name is CareAssist. Are you calling to register as a new patient today or update your information?",
  "endCallPhrases": [
    "goodbye",
    "have a nice day",
    "thank you, bye",
    "end call"
  ]
}
